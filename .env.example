NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required to commit AI results; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
# Llama 3 was retired on Groq free tier August 16, 2026.
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback, or use Gemini alone by leaving GROQ_API_KEY blank.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional server-side account alias. This is a public account UUID, never a password.
IDEADNA_OWNER_USER_ID=
